# ============================================================
# TechnoUltra — variables de entorno
# Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env.local ni valores reales al repositorio.
# Solo las variables NEXT_PUBLIC_* llegan al navegador.
# ============================================================

# ---------- PÚBLICAS (seguras para el navegador) ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# ---------- SOLO SERVIDOR (nunca NEXT_PUBLIC_) ----------
SUPABASE_SERVICE_ROLE_KEY=

# IA (Google AI Studio / Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=

# Mercado Pago (usar credenciales de PRUEBA en development/preview)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Correo (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Cloudinary (evidencias)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Seguridad / operación
DOCUMENT_SIGNING_SALT=
CRON_SECRET=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
